# Copy to terraform.tfvars (git-ignored) and fill in. Never commit terraform.tfvars.
allowed_account_id = "<12-digit-account-id>"
domain             = "gatepass.<my-domain>"   # for the SES identity ARN of the notifications worker
# Same value as in 40-data/terraform.tfvars (the SES sandbox recipient; empty after production access).
ses_sandbox_recipient = "you@example.com"
