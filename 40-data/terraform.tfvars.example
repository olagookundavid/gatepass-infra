# Copy to terraform.tfvars (git-ignored) and fill in. Never commit terraform.tfvars.
allowed_account_id    = "<12-digit-account-id>"
domain                = "gatepass.<my-domain>"
ses_sandbox_recipient = "<an address that receives all mail while SES is in the sandbox>"
lambda_dist_dir       = "../../gatepass-app/dist"   # `make lambda-zip` in gatepass-app builds it
